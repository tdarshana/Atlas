{
  "name": "atlas",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "vitest run",
    "gen:types": "ATLAS_WRITE_TS=1 cargo test -p atlas-core --lib tsgen",
    "gen:api": "ATLAS_WRITE_TS=1 cargo test -p atlasd --bin atlasd apigen"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.40.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@xyflow/svelte": "^1.6.0",
    "dompurify": "3.4.14",
    "highlight.js": "11.12.0",
    "marked": "18.0.11"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.4.1",
    "jsdom": "^26",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
