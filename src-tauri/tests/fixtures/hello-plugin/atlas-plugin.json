{
  "id": "hello-world",
  "name": "Hello World",
  "version": "1.0.0",
  "description": "A minimal plugin that adds a sidebar section, a dashboard card, a task panel, a command, a theme and an MCP tool.",
  "author": "Atlas",
  "api": ">=1.0 <2",
  "main": "main.js",
  "permissions": ["ui.sections", "ui.components", "tasks.read", "mcp.tools"],
  "contributes": {
    "sections": [
      { "id": "hello", "title": "Hello", "icon": "sparkles", "view": "hello-view" }
    ],
    "components": [
      { "slot": "dashboard.card", "id": "ready", "view": "ready-card" },
      { "slot": "task.detail.panel", "id": "looking", "view": "task-panel" }
    ],
    "commands": [{ "id": "say-hello", "title": "Say hello" }],
    "themes": [{ "id": "hello-dusk", "name": "Hello dusk", "file": "theme.json" }],
    "tools": [
      {
        "name": "ready_count",
        "description": "Count the ready tasks on the board",
        "args": { "type": "object", "properties": {}, "additionalProperties": false },
        "scope": "read"
      }
    ]
  }
}
